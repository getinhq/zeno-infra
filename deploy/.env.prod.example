# --- Hosted Zeno: copy to .env.prod and fill in. Never commit .env.prod. ---

# Public hostname of the dashboard (DNS A record -> this server). Caddy gets HTTPS for it.
ZENO_DOMAIN=zeno.example.com
ZENO_PUBLIC_HOST=zeno.example.com

# Postgres. If the password contains special characters, put its URL-encoded form in
# POSTGRES_PASSWORD_URLENCODED (e.g. "@" -> "%40"); otherwise use the same value.
POSTGRES_USER=zeno
POSTGRES_DB=zeno
POSTGRES_PASSWORD=change-me
POSTGRES_PASSWORD_URLENCODED=change-me

# 32+ random characters each:  openssl rand -base64 48
ZENO_JWT_SECRET=
ZENO_LAUNCH_MINT_SECRET=

# Let anyone create a studio (true), or only people with an invite link (false).
ZENO_ALLOW_SIGNUP=true

# Storage for published files:
#   nas = a Docker volume on this server (default, simplest)
#   s3  = S3 / MinIO / Backblaze B2 / Cloudflare R2 (fill the S3_* values)
CAS_STORAGE_BACKEND=nas
S3_ENDPOINT_URL=
S3_BUCKET_CAS=zeno-cas
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: email invites. Without it, invites are copyable links.
ZENO_SMTP_HOST=
ZENO_SMTP_PORT=587
ZENO_SMTP_USERNAME=
ZENO_SMTP_PASSWORD=
ZENO_SMTP_FROM=

API_WORKERS=2
BACKUP_KEEP_DAYS=14
# Change only for local testing (e.g. 8080 / 8443).
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Review: how many uploads are converted at once (each ffmpeg job uses ~1-2 CPU cores)
# and the largest playblast/render accepted.
ZENO_REVIEW_WORKERS=1
ZENO_REVIEW_MAX_UPLOAD_MB=4096
