# Postgres 16
POSTGRES_USER=zeno_admin
POSTGRES_PASSWORD=ZenoChimera@25
POSTGRES_DB=zeno_db

# Connection URL for zeno-api when running API on host (optional; in Docker Compose the API builds URL from POSTGRES_*)
# If password contains @, use %40 (e.g. ZenoChimera%4025). For Docker, POSTGRES_PASSWORD is passed as-is into the API container.
DATABASE_URL=postgresql://zeno_admin:ZenoChimera%4025@localhost:5432/zeno_db
# MongoDB 7 — use database in URI (e.g. ...mongodb.net/zeno_db) or set ZENO_MONGO_DB
# MONGO_URI=mongodb+srv://chimera:ZenoChimera%4025@zeno-cluster.v4mojfj.mongodb.net/zeno-cluster?retryWrites=true&w=majority&appName=zeno-cluster
MONGO_URI=mongodb://localhost:27017/zeno_db
# ZENO_MONGO_DB=zeno_db

# Redis 7 (required for presence/locks; used by API in Docker)
REDIS_URL=redis://localhost:6379/0

# API (when running in Docker Compose, these are set from the vars above; hostnames use service names)
# ZENO_CAS_ROOT=/app/cas_data

# MinIO (S3-compatible) — use with: docker compose --profile full up -d
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# Inside the API container use http://minio:9000; from the host use http://localhost:9000
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET_CAS=zeno-cas
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# CAS_STORAGE_BACKEND=auto
