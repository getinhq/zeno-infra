# Postgres 16
POSTGRES_USER=zeno
POSTGRES_PASSWORD=zeno
POSTGRES_DB=zeno

# Connection URL for zeno-api (optional; API can build from vars above)
# DATABASE_URL=postgresql://zeno:zeno@localhost:5432/zeno

# MongoDB 7
# MONGO_URI=mongodb://localhost:27017

# Redis 7
# REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible) — uncomment if using profile "full"
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET_CAS=zeno-cas
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
